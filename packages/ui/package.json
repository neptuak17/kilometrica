{
  "name": "@dpg/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kilometrica's UI kit (D53): shadcn/ui on React Aria with the owner's preset, Kilometrica's own components and purpose-named tokens. Used by the rider views and synced to Claude Design.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "publishConfig": {
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && tailwindcss -i src/styles/kit.css -o dist/styles.css && node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react-aria-components": "^1.22.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.8.16"
  }
}
